.console-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0,0,0,0.35); }
.console-window { position: absolute; left: 3%; top: 4%; width: 94%; height: 76%; background-color: rgb(0,0,0); padding: 14px; color: rgb(255,255,255); font-size: 15px; }
.console-titlebar { flex-direction: row; justify-content: space-between; align-items: center; height: 26px; margin-bottom: 7px; flex-shrink: 0; }
.console-titlebar Label { font-size: 16px; color: rgb(255,255,255); }
.console-titlebar Button { width: 26px; height: 24px; margin: 0; }
.console-output { flex-grow: 1; min-height: 0; background-color: rgb(0,0,0); padding: 0; }
.console-line { font-size: 14px; color: rgb(255,255,255); white-space: normal; flex-shrink: 0; margin: 0; padding: 1px 0; -unity-font-style: normal; }
.console-command-row { flex-direction: row; align-items: center; height: 32px; margin-top: 8px; flex-shrink: 0; border-top-width: 1px; border-top-color: rgb(70,70,70); padding-top: 4px; }
.console-command-row > Label { width: 17px; color: rgb(255,255,255); }
#console-input { flex-grow: 1; margin: 0 8px 0 0; }
#console-input .unity-text-field__input { background-color: rgb(0,0,0); color: rgb(255,255,255); border-width: 0; border-radius: 0; padding: 3px; font-size: 15px; --unity-cursor-color: rgb(255,255,255); --unity-selection-color: rgba(255,255,255,0.3); }
#console-input.console-caret-off .unity-text-field__input { --unity-cursor-color: rgba(255,255,255,0); }
.console-window Button { background-color: rgb(0,0,0); color: rgb(255,255,255); border-radius: 0; border-width: 0; font-size: 14px; }
.console-window Button:hover { background-color: rgb(35,35,35); }
.console-window Button:active { background-color: rgb(60,60,60); }
#console-submit { height: 27px; width: 80px; margin: 0; }
.console-footer { font-size: 12px; color: rgb(255,255,255); margin-top: 7px; flex-shrink: 0; }
.console-output .unity-scroller--vertical { width: 5px; min-width: 5px; }
.console-output .unity-scroller__low-button, .console-output .unity-scroller__high-button { display: none; }
.console-output .unity-base-slider__tracker { background-color: rgb(0,0,0); }
.console-output .unity-base-slider__dragger { background-color: rgb(200,200,200); border-width: 0; border-radius: 0; }
